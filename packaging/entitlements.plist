<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened Runtime entitlements for notarized distribution.
  - audio-input: the app records from the microphone.
  - disable-library-validation: the bundled Python loads third-party .dylib/.so
    (ctranslate2, onnxruntime, ffmpeg, …) that aren't all signed by our team;
    without this, hardened runtime would refuse to load them.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
